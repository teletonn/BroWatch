[Unit]
Description=BroWatch USB bridge gateway (%i)
# NB: NO BindsTo=dev-%i.device here on purpose. BindsTo stops the gateway
# the moment the board is unplugged, and with no udev rule installed
# nothing ever starts it again -- the classic "replug and silence".
# serial_loop() already survives a dead port by itself (open fails ->
# backoff -> reopen + hello resync), so the gateway simply stays up
# across unplug/replug cycles and picks the board back up alone.
After=browatch-web.service

[Service]
Type=simple
# %i — ttyUSB0 и т.п. Скорость: 2000000 для плат, 921600 для ESP32-донгла.
# Для донгла: systemctl --user edit browatch-gateway@ttyUSB0 --full и поменять baud.
ExecStart=/usr/bin/python3 %h/.local/share/browatch-web/gateway.py --port /dev/%i --baud 2000000
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
